# Environment Configuration Template for SpectralReader Document Intelligence Engine

# Server Binding & Port
HOST=0.0.0.0
PORT=8000

# Logging Verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# FastAPI Backend Service Base URL
API_BASE_URL=http://localhost:8000

# Streamlit Client Target Backend URL (for local dev or container networking)
STREAMLIT_BACKEND_URL=http://localhost:8000

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGINS=*

# --- LLM Provider Settings ---
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
GEMINI_DEFAULT_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# --- OCR Engine Settings ---
ENABLE_OCR=true
OCR_PROVIDER=tesseract
OCR_MIN_TEXT_CHARS_PER_PAGE=50

# Optional Hugging Face Access Token (for authenticated model downloads if required)
#HF_TOKEN=hf_key

# Optional Local Directory Path for Caching Models
#MODEL_CACHE_DIR=/root/.cache/huggingface
