# Environment Configuration Template for SpectralReader Document Intelligence Engine

# Server Binding & Port
HOST=0.0.0.0
PORT=8000

# Logging Verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# FastAPI Backend Service Base URL
API_BASE_URL=http://localhost:8000

# Streamlit Client Target Backend URL (for local dev or container networking)
STREAMLIT_BACKEND_URL=http://localhost:8000

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGINS=*

# Optional Hugging Face Access Token (for authenticated model downloads if required)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Local Directory Path for Caching Hugging Face Models
# MODEL_CACHE_DIR=./.model_cache
